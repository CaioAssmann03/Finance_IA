# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# O .env.local é ignorado pelo git — NUNCA versione chaves de verdade.

# ---------------------------------------------------------------------------
# Supabase — painel do projeto > Project Settings > API
# ---------------------------------------------------------------------------

# ATENÇÃO: aqui vai a URL do projeto, não uma chave.
# Formato certo:  https://xxxxxxxxxxxxxxxx.supabase.co
# Errado (é chave, não URL): sb_publishable_..., eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave pública (anon / publishable). Vai para o navegador — pode ser lida por
# qualquer visitante. É segura desde que a RLS esteja ativa em todas as tabelas,
# como faz a migração 0001 + 0003.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role / secret). Ignora a RLS e consegue apagar
# usuários. SÓ pode ser usada em código de servidor (app/api/**). Nunca use o
# prefixo NEXT_PUBLIC_ nela, senão o Next embute a chave no bundle do navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Anthropic — usada pelo assistente financeiro (app/api/ia/**)
# Gerada em https://console.anthropic.com. Opcional: sem ela o resto do app
# funciona normalmente, só o assistente responde com erro.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
